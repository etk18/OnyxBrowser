# ── OnyxBrowser Backend — Environment Variables ──
#
# Copy this file to .env and fill in your API keys.
#   cp .env.example .env
#
# The agent needs at least ONE of the two LLM keys below.

# ── LLM Provider (pick one or both) ──────────────────────────
# Groq is checked first (fast inference, generous free tier).
# Also used for Whisper voice transcription (whisper-large-v3-turbo).
GROQ_API_KEY=
OPENAI_API_KEY=

# ── Optional: override the default model ─────────────────────
# Groq default:   llama-3.3-70b-versatile
# OpenAI default:  gpt-4o-mini
# LLM_MODEL=
