{
  "name": "onyx-browser",
  "version": "2.0.0",
  "description": "The Agentic Web Engine.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && ELECTRON_RUN_AS_NODE= electron .\"",
    "build": "vite build",
    "postinstall": "electron-builder install-app-deps && chmod +x node_modules/app-builder-bin/mac/app-builder_arm64",
    "build:shield": "cd onyx-shield && npm install && npm run build && cd ..",
    "build:win": "npm run build:shield && npm run build && electron-builder --win --x64 --publish always",
    "build:mac": "npm run build:shield && npm run build && electron-builder --mac --arm64 --publish always",
    "dist": "npm run build:shield && npm run build && electron-builder --mac --arm64 --publish always && electron-builder --win --x64 --publish always",
    "preview": "vite preview"
  },
  "author": "Eesh Sagar",
  "build": {
    "appId": "com.eesh.onyx",
    "productName": "Onyx",
    "executableName": "Onyx",
    "compression": "maximum",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "extensions/**/*",
      "package.json",
      "!**/.env",
      "!**/.env.*",
      "!**/*.map",
      "!**/node_modules/.cache/**",
      "!**/.DS_Store",
      "!**/thumbs.db",
      "!**/config.json",
      "!**/__pycache__/**",
      "!**/backend/**",
      "!**/src/**",
      "!**/.git/**",
      "!**/.github/**",
      "!**/.vscode/**",
      "!**/.idea/**",
      "!**/release/**",
      "!**/coverage/**"
    ],
    "extraResources": [
      {
        "from": "backend/dist/onyx-brain",
        "to": "onyx-brain",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico",
      "legalTrademarks": "Onyx AI"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Onyx",
      "uninstallDisplayName": "Onyx",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "protocols": [
      {
        "name": "Onyx Protocol",
        "schemes": ["onyx"]
      }
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "build/icon.icns",
      "artifactName": "Onyx-Mac-${arch}.${ext}",
      "category": "public.app-category.productivity"
    },
    "dmg": {
      "title": "Install Onyx Browser",
      "icon": "build/icon.icns",
      "contents": [
        {
          "x": 130,
          "y": 150
        },
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }
  },
  "dependencies": {
    "@cliqz/adblocker-electron": "^1.34.0",
    "@google/generative-ai": "^0.24.1",
    "@web3modal/ethers": "^4.2.2",
    "cross-fetch": "^4.1.0",
    "dayjs": "^1.11.19",
    "electron-context-menu": "^4.1.1",
    "electron-store": "^11.0.2",
    "ethers": "^6.16.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0",
    "vite": "^7.3.1",
    "wait-on": "^7.2.0"
  }
}